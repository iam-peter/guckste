[Desktop Entry]
Type=Application
Name=Guckste
GenericName=Screenshot Tool
Comment=Take screenshots, annotate them and measure pixels
Exec=guckste gui
Icon=guckste
Terminal=false
Categories=Graphics;
Keywords=screenshot;capture;annotate;measure;
StartupWMClass=guckste
Actions=Full;Editor;

[Desktop Action Full]
Name=Capture All Screens
Exec=guckste full

[Desktop Action Editor]
Name=Open an Image in the Editor
Exec=guckste open
